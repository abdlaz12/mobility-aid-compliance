# Copy to .env and fill in. Never commit .env.
DATABASE_URL="file:./dev.db"

# Shared secret the model service (or mock generator) sends as "Authorization: Bearer <key>".
# Generate a long random value for real use.
INTAKE_API_KEY="dev-only-change-me"

# Compliance engine settings (optional; these are the defaults).
IDENTITY_CONFIDENCE_THRESHOLD="0.6"
AID_CONFIDENCE_THRESHOLD="0.6"
ACK_TIMEOUT_MINUTES="10"

# Auth.js session signing key. Generate a real one with: npx auth secret
# (the app refuses to start in production while this is the dev placeholder)
AUTH_SECRET="dev-only-change-me-use-npx-auth-secret-for-real"

# Notifications. Delivery uses the server log in development. To send real pushes through Pushover, set the
# application token and give users a pushoverUserKey (no screen for that yet; set it in the database).
# Only room, aid status, time and initials/ID are ever sent, never a full name.
# PUSHOVER_APP_TOKEN=""
# Set to "off" to stop the background loop (escalation and delivery), for example on serverless hosting.
# BACKGROUND_JOBS="off"
