# Copy to .env and fill in. Never commit .env.
DATABASE_URL="file:./dev.db"

# Shared secret the model service (or mock generator) sends as "Authorization: Bearer <key>".
# Generate a long random value for real use.
INTAKE_API_KEY="dev-only-change-me"

# Compliance engine settings (optional; these are the defaults).
IDENTITY_CONFIDENCE_THRESHOLD="0.6"
AID_CONFIDENCE_THRESHOLD="0.6"
ACK_TIMEOUT_MINUTES="10"
